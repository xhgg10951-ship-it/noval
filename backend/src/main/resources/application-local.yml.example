# Example local configuration for story-ai-backend.
#
# Copy this file to application-local.yml (NOT committed) or export the env
# vars directly. The repo must never contain real passwords.
#
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# Then activate it with:  spring.profiles.active=local
# or pass env vars:  DB_URL=... DB_USERNAME=... DB_PASSWORD=... AI_SERVICE_URL=...

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/story_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=utf8
    username: story_dev
    password: CHANGE_ME
    driver-class-name: com.mysql.cj.jdbc.Driver

ai:
  service:
    base-url: http://localhost:8000
